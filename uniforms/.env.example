# --- the workbook: this IS the database ---
WORKBOOK_PATH=./data/uniforms.xlsx
BACKUP_DIR=./data/backups
MAX_BACKUPS=10
# 03/04/2024 is 3 April when true, 4 March when false. Must match the client's locale.
DATES_DAY_FIRST=true
# Queued writes are batched; a burst of handovers costs one file write, not twenty.
FLUSH_DEBOUNCE_SECONDS=2
# How often to notice that someone edited the workbook by hand in Excel.
RELOAD_POLL_SECONDS=60

# --- policy (the client can retune these without a code change) ---
# How far ahead a renewal starts showing as due. Six months is their procurement
# lead time, so this is the number that gives them time to order.
DUE_SOON_DAYS=180
OVERDUE_GRACE_DAYS=30
FIRST_ISSUE_GRACE_DAYS=30
# How long the tailor may sit on a promised garment before it needs chasing.
CHASE_AFTER_DAYS=30

BRAND_NAME=Uniform Manager

# --- sign-in ---
# Off by default so a local demo needs no setup. Switch it on BEFORE this is
# reachable by anyone but you: without it, anybody who can open the URL can edit
# staff records, and "authorised by" is only a name somebody typed.
AUTH_ENABLED=false
# Signs session cookies. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
# Unset means sessions do not survive a restart.
SECRET_KEY=
# name:secret:role, comma separated. Role is admin (can edit) or viewer (read only).
# Generate the secret with: python scripts/hash_password.py 'their password'
# Plaintext works for a quick pilot but is warned about at startup.
AUTH_USERS=
