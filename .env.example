# ─────────────────────────────────────────────────────────────
#  LeadSystem configuration.  Copy to `.env` and fill in.
#  Every external dependency is OPTIONAL — with none of them set,
#  the app runs end-to-end on mock data so you can try it offline.
# ─────────────────────────────────────────────────────────────

# ── AI layer (open-source, no Anthropic) ─────────────────────
# provider: ollama | openai_compatible | groq | openrouter
# All four speak the OpenAI-compatible /v1/chat/completions API.
LLM_PROVIDER=ollama

# For Ollama (default, free, self-hosted):
#   1. Install: https://ollama.com/download
#   2. Pull a model: `ollama pull llama3.1:8b`  (or qwen2.5, mistral)
#   3. Ollama serves on http://localhost:11434 automatically.
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=

# Free hosted alternatives (no local install) — uncomment a set:
#   Groq (fast, free tier):
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_free_groq_key
#   OpenRouter (many free models, suffix :free):
# LLM_PROVIDER=openrouter
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-your_free_openrouter_key

# ── Creator discovery ────────────────────────────────────────
# provider: auto | youtube | apify
#   auto = free YouTube API when a key is set + platform is youtube,
#          else Apify if a token is set, else built-in sample data.
DISCOVERY_PROVIDER=auto

# YouTube Data API v3 — FREE, no billing, low maintenance (best value).
#   1. https://console.cloud.google.com/  → create/select a project
#   2. APIs & Services → Library → enable "YouTube Data API v3"
#   3. APIs & Services → Credentials → Create credentials → API key
# 10,000 free units/day (~100 niche searches). Used when platform=youtube.
YOUTUBE_API_KEY=

# Apify — optional, pay-as-you-go (small free monthly credit). Only needed for
# Instagram / TikTok discovery; without it those platforms use sample data.
APIFY_TOKEN=
APIFY_CREATOR_ACTOR=apify/instagram-search-scraper

# ── Google Sheets sync (optional) ────────────────────────────
SHEETS_ENABLED=false
SHEETS_SPREADSHEET_ID=
# Path to a Google service-account JSON key file.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# ── Email sending (optional; SMTP) ───────────────────────────
# Without SMTP, campaigns are drafted + logged but not delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=you@example.com
SMTP_FROM_NAME=Your Name

# ── App ──────────────────────────────────────────────────────
# Public base URL, used to build unsubscribe + tracking links.
APP_BASE_URL=http://localhost:8020
DATABASE_URL=sqlite:///./data/leadsystem.db
