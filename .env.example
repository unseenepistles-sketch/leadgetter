# ---- Copy to .env and fill in. Everything works with graceful degradation:
# ---- unset keys simply disable that integration (the app still runs). ----

# Database. SQLite for local dev; Compose overrides this with Postgres.
DATABASE_URL=sqlite:///./leadsystem.db

# Public URL of this app (used in opt-in links)
PUBLIC_BASE_URL=http://localhost:8000

# Your brand / offer (shown on the landing page + used by the AI copywriter)
BRAND_NAME=Your Brand
PRODUCT=a book on Christian spirituality and awakening
LEAD_MAGNET=a free chapter

# ---- AI layer (Anthropic) ----
ANTHROPIC_API_KEY=
HAIKU_MODEL=claude-haiku-4-5      # cheap: niche-term expansion + creator ranking
COPY_MODEL=claude-sonnet-5        # higher quality: outreach + email copy

# ---- Creator discovery ----
YOUTUBE_API_KEY=                  # YouTube Data API v3 key (free 10k units/day)
APIFY_TOKEN=                      # Apify token (free $5/mo) for public IG/TikTok data

# ---- Email engine (self-hosted Listmonk) ----
LISTMONK_URL=http://localhost:9000
LISTMONK_USER=
LISTMONK_PASSWORD=
LISTMONK_LIST_ID=0                # numeric id of the Listmonk list leads subscribe to

# ---- Lead storage sync (Google Sheets) ----
GOOGLE_SA_JSON=                   # path to a Google service-account JSON file
SHEET_ID=                         # target spreadsheet id (share it with the SA email)
