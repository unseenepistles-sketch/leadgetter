# The API and pricing engine run with none of these set — Milestone 1 is headless
# and storage-free. Fill them in when you seed the database.
DATABASE_URL="postgresql://moveon:moveon@localhost:5432/moveon"
REDIS_URL="redis://localhost:6379"
PORT=3000

# Milestone 2+: duration_in_traffic is what makes time pricing possible (§6).
# Abstracted behind a RoutingProvider interface — you will switch when the bill arrives.
GOOGLE_MAPS_API_KEY=
